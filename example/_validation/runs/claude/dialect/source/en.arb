{
  "@@locale": "en",

  "checkout.bookNow": "Book Now",
  "@checkout.bookNow": {
    "description": "Primary CTA on the checkout screen. 'Book' is a verb meaning 'make a reservation' (see glossary). Used on a confirm-and-pay button.",
    "context": "checkout_screen"
  },

  "checkout.bookingConfirmed": "Booking confirmed. Check your trips for details.",
  "@checkout.bookingConfirmed": {
    "description": "Snackbar message shown after the user successfully completes a booking. 'trips' refers to the user's list of booked stays (see glossary: Trip).",
    "context": "checkout_screen"
  },

  "checkout.confirmAndPay": "Confirm and pay",
  "@checkout.confirmAndPay": {
    "description": "AppBar title on the checkout/payment screen. Instructs the user they are about to confirm their booking and complete payment.",
    "context": "checkout_screen"
  },

  "checkout.freeCancellation": "Free cancellation for 48 hours",
  "@checkout.freeCancellation": {
    "description": "Policy note shown below the price summary on the checkout screen. Informs the user they can cancel for free within 48 hours.",
    "context": "checkout_screen"
  },

  "checkout.hostedBy": "Hosted by {hostName}",
  "@checkout.hostedBy": {
    "description": "Subtitle shown under the listing title on the checkout screen. 'Host' is a person who lists their property (see glossary: Host). {hostName} is the host's first name.",
    "context": "checkout_screen",
    "placeholders": {
      "hostName": { "type": "String" }
    }
  },

  "checkout.itemCount": "{count, plural, =0{No items} =1{1 item} other{{count} items}}",
  "@checkout.itemCount": {
    "description": "Item summary on the checkout cart line. Used in body text, not a button.",
    "context": "checkout_screen",
    "placeholders": {
      "count": { "type": "int" }
    }
  },

  "checkout.legalAgreement": "By booking you agree to the House Rules and Cancellation Policy.",
  "@checkout.legalAgreement": {
    "description": "Legal disclaimer shown at the bottom of the checkout screen. 'booking' is the act of making a reservation (see glossary: Book). 'House Rules' and 'Cancellation Policy' are proper names for platform policy documents — do not translate them as generic phrases.",
    "context": "checkout_screen"
  },

  "checkout.nightsCount": "{nights, plural, =1{1 night} other{{nights} nights}}",
  "@checkout.nightsCount": {
    "description": "Duration line in the trip summary on the checkout screen. Shows how many nights the stay covers.",
    "context": "checkout_screen",
    "placeholders": {
      "nights": { "type": "int" }
    }
  },

  "checkout.pricePerNight": "${price} per night",
  "@checkout.pricePerNight": {
    "description": "Per-night price line in the trip summary on the checkout screen. {price} is an integer dollar amount (e.g. 82). Do not move or translate the '$' symbol — currency repositioning is a runtime formatting concern.",
    "context": "checkout_screen",
    "placeholders": {
      "price": { "type": "int" }
    }
  },

  "checkout.total": "Total: ${total}",
  "@checkout.total": {
    "description": "Total price line at the bottom of the checkout summary. {total} is an integer dollar amount. Do not move or translate the '$' symbol.",
    "context": "checkout_screen",
    "placeholders": {
      "total": { "type": "int" }
    }
  },

  "checkout.yourTrip": "Your trip",
  "@checkout.yourTrip": {
    "description": "Section heading on the checkout screen that introduces the trip summary (dates, nights, price). 'Trip' means the booked stay (see glossary: Trip).",
    "context": "checkout_screen"
  },

  "common.cancel": "Cancel",
  "@common.cancel": {
    "description": "Cancel action label. Used on dialog buttons and as a back-out option across screens.",
    "context": "shared"
  },

  "common.loading": "Loading...",
  "@common.loading": {
    "description": "Generic loading indicator. Shown while async data is being fetched. Trailing ellipsis is intentional.",
    "context": "shared"
  },

  "home.openSettings": "Open settings",
  "@home.openSettings": {
    "description": "Button label on the home screen that navigates to the Settings screen.",
    "context": "home_screen"
  },

  "home.yourTrips": "Your trips",
  "@home.yourTrips": {
    "description": "AppBar title on the home screen. Lists the user's booked stays. 'trips' refers to booked stays (see glossary: Trip).",
    "context": "home_screen"
  },

  "settings.darkMode": "Dark mode",
  "@settings.darkMode": {
    "description": "Label for the dark mode toggle in the Preferences section of the settings screen.",
    "context": "settings_screen"
  },

  "settings.deleteAccount": "Delete account",
  "@settings.deleteAccount": {
    "description": "Destructive action list item in Account actions section. Opens a confirmation dialog before deleting.",
    "context": "settings_screen"
  },

  "settings.deleteAccountBody": "This permanently removes your bookings, trips, and host listings. This cannot be undone.",
  "@settings.deleteAccountBody": {
    "description": "Body text in the delete-account confirmation dialog. Warns the user that all their data will be lost. 'trips' = booked stays (glossary: Trip), 'host listings' = properties listed on the platform (glossary: Host).",
    "context": "settings_screen"
  },

  "settings.deleteAccountTitle": "Delete account?",
  "@settings.deleteAccountTitle": {
    "description": "Title of the confirmation dialog shown when the user taps 'Delete account'. The '?' signals a confirmation question.",
    "context": "settings_screen"
  },

  "settings.deleteConfirm": "Delete",
  "@settings.deleteConfirm": {
    "description": "Confirm button in the delete-account dialog. Distinct from common.cancel which appears alongside it. Short and destructive.",
    "context": "settings_screen"
  },

  "settings.editProfile": "Tap to edit your profile",
  "@settings.editProfile": {
    "description": "Subtitle on the profile list tile in the Account section of settings. Invites the user to open their profile editor.",
    "context": "settings_screen"
  },

  "settings.email": "Email",
  "@settings.email": {
    "description": "Label for the email address field in the Account section of settings.",
    "context": "settings_screen"
  },

  "settings.language": "Language",
  "@settings.language": {
    "description": "Label for the language selector list tile in the Preferences section of settings.",
    "context": "settings_screen"
  },

  "settings.notifications": "Notifications",
  "@settings.notifications": {
    "description": "Label for the notifications toggle in the Preferences section of settings.",
    "context": "settings_screen"
  },

  "settings.notificationsSubtitle": "Trip updates, host messages, and booking reminders.",
  "@settings.notificationsSubtitle": {
    "description": "Subtitle under the Notifications toggle describing what kinds of notifications the user will receive. 'Trip' = booked stay (glossary: Trip), 'host' = property owner (glossary: Host).",
    "context": "settings_screen"
  },

  "settings.sectionAccount": "Account",
  "@settings.sectionAccount": {
    "description": "Section header label for the Account section in the settings screen. Rendered in uppercase by the UI.",
    "context": "settings_screen"
  },

  "settings.sectionAccountActions": "Account actions",
  "@settings.sectionAccountActions": {
    "description": "Section header label for the Account actions section (sign out, delete account) in the settings screen. Rendered in uppercase by the UI.",
    "context": "settings_screen"
  },

  "settings.sectionPreferences": "Preferences",
  "@settings.sectionPreferences": {
    "description": "Section header label for the Preferences section (dark mode, notifications, language) in the settings screen. Rendered in uppercase by the UI.",
    "context": "settings_screen"
  },

  "settings.signOut": "Sign out",
  "@settings.signOut": {
    "description": "Action list item in Account actions section of settings. Logs the user out of the app.",
    "context": "settings_screen"
  },

  "settings.title": "Settings",
  "@settings.title": {
    "description": "AppBar title on the Settings screen.",
    "context": "settings_screen"
  }
}
