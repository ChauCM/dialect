{
  "@@locale": "en",

  "checkout.bookNow": "Book Now",
  "@checkout.bookNow": {
    "description": "Primary CTA on the checkout screen. 'Book' is a verb meaning 'make a reservation' (see glossary). Used on a confirm-and-pay button.",
    "context": "checkout_screen"
  },

  "checkout.bookingConfirmed": "Booking confirmed. Check your trips for details.",
  "@checkout.bookingConfirmed": {
    "description": "Success snackbar after payment. 'Booking' is the reservation (noun), not a physical book. 'Trips' refers to booked stays (see glossary).",
    "context": "checkout_screen"
  },

  "checkout.confirmAndPay": "Confirm and pay",
  "@checkout.confirmAndPay": {
    "description": "App bar title on the checkout / payment review screen.",
    "context": "checkout_screen"
  },

  "checkout.freeCancellation": "Free cancellation for 48 hours",
  "@checkout.freeCancellation": {
    "description": "Policy reassurance line below the price breakdown. The duration is fixed marketing copy, not a runtime-formatted value.",
    "context": "checkout_screen"
  },

  "checkout.hostedBy": "Hosted by {hostName}",
  "@checkout.hostedBy": {
    "description": "Subtitle under the listing title on checkout. 'Host' is the property owner (see glossary). {hostName} is sample profile data.",
    "context": "checkout_screen",
    "placeholders": {
      "hostName": { "type": "String" }
    }
  },

  "checkout.itemCount": "{count, plural, =0{No items} =1{1 item} other{{count} items}}",
  "@checkout.itemCount": {
    "description": "Item summary on the checkout cart line. Used in body text, not a button.",
    "context": "checkout_screen",
    "placeholders": {
      "count": { "type": "int" }
    }
  },

  "checkout.legalDisclaimer": "By booking you agree to the House Rules and Cancellation Policy.",
  "@checkout.legalDisclaimer": {
    "description": "Fine print below the checkout buttons. 'booking' is the verb act of reserving. House Rules and Cancellation Policy are formal policy document titles.",
    "context": "checkout_screen"
  },

  "checkout.nights": "{count, plural, =1{1 night} other{{count} nights}}",
  "@checkout.nights": {
    "description": "Stay duration line in the trip summary. {count} is the number of nights booked.",
    "context": "checkout_screen",
    "placeholders": {
      "count": { "type": "int" }
    }
  },

  "checkout.pricePerNight": "{price} per night",
  "@checkout.pricePerNight": {
    "description": "Nightly rate in the price breakdown. {price} is a pre-formatted currency string (e.g. '$82'); do not translate the symbol or digits.",
    "context": "checkout_screen",
    "placeholders": {
      "price": { "type": "String" }
    }
  },

  "checkout.total": "Total: {total}",
  "@checkout.total": {
    "description": "Bold total price line. {total} is a pre-formatted currency string (e.g. '$246').",
    "context": "checkout_screen",
    "placeholders": {
      "total": { "type": "String" }
    }
  },

  "checkout.yourTrip": "Your trip",
  "@checkout.yourTrip": {
    "description": "Section heading above dates and pricing on checkout. 'Trip' is a booked stay (see glossary), not a stumble.",
    "context": "checkout_screen"
  },

  "common.cancel": "Cancel",
  "@common.cancel": {
    "description": "Cancel action label. Used on dialog buttons and as a back-out option across screens.",
    "context": "shared"
  },

  "common.delete": "Delete",
  "@common.delete": {
    "description": "Destructive confirm action on the delete-account dialog. Short button label.",
    "context": "shared"
  },

  "common.loading": "Loading...",
  "@common.loading": {
    "description": "Generic loading indicator. Shown while async data is being fetched. Trailing ellipsis is intentional.",
    "context": "shared"
  },

  "home.hostedBy": "Hosted by {hostName}",
  "@home.hostedBy": {
    "description": "Listing card subtitle on the trips home screen. Separate key from checkout.hostedBy even though English matches. 'Host' is the property owner (see glossary).",
    "context": "home_screen",
    "placeholders": {
      "hostName": { "type": "String" }
    }
  },

  "home.openSettings": "Open settings",
  "@home.openSettings": {
    "description": "Outlined button on the home screen that navigates to Settings.",
    "context": "home_screen"
  },

  "home.tripsTitle": "Your trips",
  "@home.tripsTitle": {
    "description": "App bar title on the home screen listing the user's booked stays. 'Trips' are platform bookings (see glossary).",
    "context": "home_screen"
  },

  "settings.accountActionsSection": "Account actions",
  "@settings.accountActionsSection": {
    "description": "Section header above sign-out and delete-account rows.",
    "context": "settings_screen"
  },

  "settings.accountSection": "Account",
  "@settings.accountSection": {
    "description": "Section header above profile and email rows.",
    "context": "settings_screen"
  },

  "settings.darkMode": "Dark mode",
  "@settings.darkMode": {
    "description": "Switch label for the dark theme preference.",
    "context": "settings_screen"
  },

  "settings.deleteAccount": "Delete account",
  "@settings.deleteAccount": {
    "description": "List tile title for permanent account removal. Styled red in the UI.",
    "context": "settings_screen"
  },

  "settings.deleteAccountConfirmBody": "This permanently removes your bookings, trips, and host listings. This cannot be undone.",
  "@settings.deleteAccountConfirmBody": {
    "description": "Warning body in the delete-account confirmation dialog. 'Trips' and 'host' use glossary senses (booked stays, property owner).",
    "context": "settings_screen"
  },

  "settings.deleteAccountConfirmTitle": "Delete account?",
  "@settings.deleteAccountConfirmTitle": {
    "description": "Alert dialog title when the user taps Delete account.",
    "context": "settings_screen"
  },

  "settings.emailLabel": "Email",
  "@settings.emailLabel": {
    "description": "List tile title for the email field. The address itself is user data, not translated.",
    "context": "settings_screen"
  },

  "settings.language": "Language",
  "@settings.language": {
    "description": "List tile title for locale selection. The current language name shown in the subtitle is runtime data, not this string.",
    "context": "settings_screen"
  },

  "settings.notifications": "Notifications",
  "@settings.notifications": {
    "description": "Switch label for push/email notification preference.",
    "context": "settings_screen"
  },

  "settings.notificationsSubtitle": "Trip updates, host messages, and booking reminders.",
  "@settings.notificationsSubtitle": {
    "description": "Subtitle under the notifications switch explaining what alerts are sent. Uses glossary Trip and Host senses.",
    "context": "settings_screen"
  },

  "settings.preferencesSection": "Preferences",
  "@settings.preferencesSection": {
    "description": "Section header above dark mode, notifications, and language.",
    "context": "settings_screen"
  },

  "settings.signOut": "Sign out",
  "@settings.signOut": {
    "description": "List tile to log the user out of their account.",
    "context": "settings_screen"
  },

  "settings.tapToEditProfile": "Tap to edit your profile",
  "@settings.tapToEditProfile": {
    "description": "Subtitle on the profile row prompting the user to open profile editing.",
    "context": "settings_screen"
  },

  "settings.title": "Settings",
  "@settings.title": {
    "description": "App bar title on the settings screen.",
    "context": "settings_screen"
  }
}
