{
  "@@locale": "en",

  "checkout.agreementNotice": "By booking you agree to the House Rules and Cancellation Policy.",
  "@checkout.agreementNotice": {
    "description": "Legal acknowledgement shown near the bottom of checkout before the user confirms payment.",
    "context": "checkout_screen"
  },

  "checkout.bookNow": "Book Now",
  "@checkout.bookNow": {
    "description": "Primary CTA on the checkout screen. 'Book' is a verb meaning 'make a reservation' (see glossary). Used on a confirm-and-pay button.",
    "context": "checkout_screen"
  },

  "checkout.bookingConfirmedMessage": "Booking confirmed. Check your trips for details.",
  "@checkout.bookingConfirmedMessage": {
    "description": "Snackbar message shown after a successful booking confirmation. 'Trips' refers to booked stays in the app.",
    "context": "checkout_screen"
  },

  "checkout.confirmAndPay": "Confirm and pay",
  "@checkout.confirmAndPay": {
    "description": "Checkout app bar title shown while the user reviews details before booking.",
    "context": "checkout_screen"
  },

  "checkout.freeCancellationWindow": "Free cancellation for 48 hours",
  "@checkout.freeCancellationWindow": {
    "description": "Policy note under the total price indicating the free cancellation window length.",
    "context": "checkout_screen"
  },

  "checkout.hostedBy": "Hosted by {hostName}",
  "@checkout.hostedBy": {
    "description": "Host attribution line under the listing title. 'Host' means the person listing the property.",
    "context": "checkout_screen",
    "placeholders": {
      "hostName": { "type": "String" }
    }
  },

  "checkout.itemCount": "{count, plural, =0{No items} =1{1 item} other{{count} items}}",
  "@checkout.itemCount": {
    "description": "Item summary on the checkout cart line. Used in body text, not a button.",
    "context": "checkout_screen",
    "placeholders": {
      "count": { "type": "int" }
    }
  },

  "checkout.nightsCount": "{count, plural, =1{1 night} other{{count} nights}}",
  "@checkout.nightsCount": {
    "description": "Trip duration row in checkout, showing number of nights booked.",
    "context": "checkout_screen",
    "placeholders": {
      "count": { "type": "int" }
    }
  },

  "checkout.pricePerNight": "${pricePerNight} per night",
  "@checkout.pricePerNight": {
    "description": "Line item in checkout showing nightly rate. Keep the dollar symbol position as in source.",
    "context": "checkout_screen",
    "placeholders": {
      "pricePerNight": { "type": "int" }
    }
  },

  "checkout.totalAmount": "Total: ${total}",
  "@checkout.totalAmount": {
    "description": "Checkout total amount label before the final action button.",
    "context": "checkout_screen",
    "placeholders": {
      "total": { "type": "int" }
    }
  },

  "checkout.yourTrip": "Your trip",
  "@checkout.yourTrip": {
    "description": "Section header in checkout summarizing itinerary and pricing details.",
    "context": "checkout_screen"
  },

